# =============================================================
# EDU RAG — Environment template
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored — never commit real secrets.
# =============================================================

# ---- PostgreSQL (pgvector) ----
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ragdb

# ---- n8n ----
# Generate a random 32+ char string, e.g.:
#   openssl rand -base64 48
# or in PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))
N8N_ENCRYPTION_KEY=replace_with_long_random_string

# ---- OpenAI (only needed for ONLINE mode with GPT-5-nano) ----
# This key is NOT read by docker-compose — it is entered manually
# inside n8n: Settings -> Credentials -> "OpenAI API".
# Listed here only for reference.
# OPENAI_API_KEY=sk-...
